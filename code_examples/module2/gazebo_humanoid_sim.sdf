<?xml version="1.0"?>
<sdf version="1.7">
  <model name="gazebo_humanoid">
    <link name="base_link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.01</iyy><iyz>0.0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry><box><size>0.1 0.1 0.2</size></box></geometry>
        <material><diffuse>0 0 0.8 1</diffuse></material>
      </visual>
      <collision name="base_collision">
        <geometry><box><size>0.1 0.1 0.2</size></box></geometry>
      </collision>
    </link>

    <link name="torso_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.05</iyy><iyz>0.0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <visual name="torso_visual">
        <geometry><box><size>0.15 0.15 0.3</size></box></geometry>
        <material><diffuse>0 0.8 0 1</diffuse></material>
      </visual>
      <collision name="torso_collision">
        <geometry><box><size>0.15 0.15 0.3</size></box></geometry>
      </collision>
    </link>

    <joint name="base_to_torso" type="fixed">
      <parent>base_link</parent>
      <child>torso_link</child>
      <pose>0 0 0.25 0 0 0</pose>
    </joint>

    <link name="head_link">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.005</iyy><iyz>0.0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <visual name="head_visual">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><diffuse>0.8 0 0 1</diffuse></material>
      </visual>
      <collision name="head_collision">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
      </collision>
    </link>

    <joint name="torso_to_head" type="revolute">
      <parent>torso_link</parent>
      <child>head_link</child>
      <pose>0 0 0.2 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit lower="-0.5" upper="0.5"/>
      </axis>
    </joint>

    <link name="right_upper_arm_link">
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.001</iyy><iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="right_upper_arm_visual">
        <geometry><cylinder><radius>0.03</radius><length>0.15</length></cylinder></geometry>
        <material><diffuse>0.8 0.8 0 1</diffuse></material>
      </visual>
      <collision name="right_upper_arm_collision">
        <geometry><cylinder><radius>0.03</radius><length>0.15</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="torso_to_right_upper_arm" type="revolute">
      <parent>torso_link</parent>
      <child>right_upper_arm_link</child>
      <pose>-0.1 0 0.1 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit lower="-1.57" upper="1.57"/>
      </axis>
    </joint>

  </model>
</sdf>